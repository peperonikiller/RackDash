[Unit]
Description=RackDash rackmount dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_LINUX_USER
WorkingDirectory=/PATH/TO/RackDash
ExecStart=/PATH/TO/RackDash/venv/bin/python /PATH/TO/RackDash/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
