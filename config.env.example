# RackDash core
RACKDASH_HOST=127.0.0.1
RACKDASH_PORT=8080
ROTATE_SECONDS=30
RACKDASH_THEME=dark
RACKDASH_UI_SCALE=1.0
RACKDASH_SAFE_AREA=0
RACKDASH_LARGE_TOUCH=false
RACKDASH_BURN_IN=false
RACKDASH_BURN_IN_SECONDS=90
RACKDASH_DIM_MINUTES=0
RACKDASH_DEVELOPER_MODE=false
RACKDASH_DAILY_UPDATE_CHECK=false
PLUGINS_DAILY_UPDATE_CHECK=false


# WLED network lighting
WLED_ENABLED=false
WLED_URL=http://wled.local
WLED_SEGMENT=0
WLED_BRIGHTNESS=35
WLED_STATUS_MODE=center_breathe
WLED_BREATHE_SECONDS=4.0
WLED_BREATHE_SPREAD=65
WLED_BREATHE_FLOOR=8
WLED_TRANSITION_MS=350
WLED_TIMEOUT=3.0

# Optional I2C OLED display
I2C_ENABLED=false
I2C_DISPLAY=sh1106_128x64
I2C_MODE=system
I2C_BUS=1
I2C_ADDRESS=0x3C
I2C_ROTATE_SECONDS=8
I2C_CONTRAST=255

# Pi-hole
PIHOLE_URL=http://127.0.0.1
PIHOLE_PASSWORD=

# Plex
PLEX_URL=http://192.168.4.29:32400
PLEX_TOKEN=

# Weather
WEATHER_LOCATION=Cedar Rapids, IA
WEATHER_UNITS=fahrenheit

# Formula 1
F1_API=https://api.jolpi.ca/ergast/f1

# Klipper / Moonraker
KLIPPER_URL=http://192.168.4.46:7125

# Bitaxe / AxeOS
BITAXE_URL=http://192.168.4.35

# Twitch
TWITCH_CHANNELS=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Uptime Kuma
UPTIME_KUMA_URL=http://127.0.0.1:3001
UPTIME_KUMA_STATUS_PAGE=
UPTIME_KUMA_API_KEY=
UPTIME_KUMA_USERNAME=
UPTIME_KUMA_PASSWORD=
